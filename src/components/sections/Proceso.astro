---
/** PRIMERA VISITA / CÓMO TRABAJAMOS · pasos con línea de progreso. Código de PLANTILLA. */
import { getSite } from '../../lib/config';
import { anclaDe } from '../../lib/secciones';
import SectionHead from '../ui/SectionHead.astro';
import { t } from '../../i18n/es';
const { config } = getSite();
const s = config.secciones.proceso!;
---
<section class="section section--tint proceso" id={anclaDe(config, 'proceso')} aria-labelledby="proceso-title">
  <div class="container">
    <SectionHead antetitulo={s.antetitulo} titulo={s.titulo} intro={s.intro} id="proceso-title" split />
    <ol role="list" class="pasos" data-steps style={`--n:${s.pasos.length}`}>
      <span class="pasos__line" aria-hidden="true"><span class="pasos__fill" data-steps-fill></span></span>
      {s.pasos.map((p, i) => (
        <li class="paso" data-step data-reveal style={`--i:${i}`}>
          <span class="paso__dot tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="paso__body">
            <h3 class="h3"><span class="visually-hidden">{t.ui.paso} {i + 1}: </span>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pasos { position: relative; display: grid; gap: 2.25rem; padding-inline-start: 3.75rem; }
  .pasos__line { position: absolute; inset-block: 1.25rem 1.25rem; inset-inline-start: 1.25rem; inline-size: 1px; background: var(--color-line); translate: -0.5px 0; }
  .pasos__fill { position: absolute; inset: 0; background: var(--color-primary); transform-origin: top; transform: scaleY(var(--p, 1)); }
  .paso { position: relative; }
  .paso__dot { position: absolute; inset-inline-start: -3.75rem; top: 0; display: grid; place-items: center; inline-size: 2.5rem; block-size: 2.5rem; border-radius: 50%; background: var(--color-surface-2); border: 1px solid var(--color-line); font-size: var(--fs-xs); font-weight: 700; color: var(--color-ink-soft); transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .paso[data-active] .paso__dot { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-on-primary); }
  .paso__body { display: grid; gap: 0.5rem; padding-top: 0.35rem; }
  .paso__body p { color: var(--color-ink-soft); font-size: var(--fs-sm); max-inline-size: 36ch; }
  :global([data-variante='belleza']) .paso__dot { border-radius: 0; font-family: var(--font-display); font-style: italic; font-size: 0.95rem; }

  @media (min-width: 64rem) {
    .pasos { grid-template-columns: repeat(var(--n), 1fr); gap: 2rem; padding: 3.75rem 0 0; }
    .pasos__line { inset: 1.25rem 0 auto; inline-size: auto; block-size: 1px; translate: 0 -0.5px; }
    .pasos__fill { transform-origin: left; transform: scaleX(var(--p, 1)); }
    .paso__dot { inset-inline-start: 0; top: -3.75rem; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-steps]').forEach((list) => {
    const steps = [...list.querySelectorAll<HTMLElement>('[data-step]')];
    if (reduce) { steps.forEach((s) => s.setAttribute('data-active', '')); return; }
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = list.getBoundingClientRect();
      const vh = innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.75 - r.top) / (r.height + vh * 0.25)));
      list.style.setProperty('--p', p.toFixed(3));
      steps.forEach((s, i) => s.toggleAttribute('data-active', p >= i / steps.length + 0.02 || p === 1));
    };
    list.style.setProperty('--p', '0');
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  });
</script>
